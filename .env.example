# Copy to .env.local and fill in. Never commit .env.local.
# Option A: Claude (takes precedence when set). ANTHROPIC_MODEL is optional (default claude-opus-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Option B: Gemini.
GEMINI_API_KEY=
# A current Flash model id from Google AI Studio.
GEMINI_MODEL=
# true -> /api/chat and /api/backpack return mocks (also happens automatically when the key/model is missing).
NEXT_PUBLIC_USE_MOCKS=true
